@article{haeuslein2024tpps,
  title = {Dynamic Modeling, Design and Simulation of a Thermal Pumped Piston Storage within a Renewable Energy Distribution System},
  author = {Haeuslein, Dominic and Schmidt-Vollus, Ronald and Popp, Matthias and Schaefer, Micha},
  date = {2024-10},
  journaltitle = {Journal of Energy Storage},
  shortjournal = {Journal of Energy Storage},
  volume = {100},
  pages = {113348},
  issn = {2352152X},
  doi = {10.1016/j.est.2024.113348},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S2352152X24029347},
  urldate = {2025-11-21},
  abstract = {This work presents the simulation results of a novel thermal pumped piston storage (TPPS) concept, implemented as a dynamic model within a scalable, weather-dependent, renewable energy distribution system. TPPS combines potential energy storage and hot water storage in one subsurface structure to address the challenges posed by the dunkelflaute – a period of low wind and solar energy production – in the power grid and the seasonal storage demands in a heat network. To investigate the storage performance in this supply context, a dynamic TPPS simulation model is developed, which considers dominant heat transport phenomena, such as conductive and convective transport in the water body, displacement of the water by the moving piston, heat conduction in the piston and surrounding soil as well as thermal losses to the ambient air. Based on hourly region-specific (Central Europe) real data from 2016 to 2019 for renewable energy production and consumption, optimal dimensions of grid elements are identified to minimize the required storage capacity. The scaled wind and solar power supply serve to size the potential energy storage and determine the volume of water in the TPPS and, thus, the usable heat capacity. Depending on the residual power, the potential energy storage varies between fully charged and fully discharged states. The required charging or discharging water mass flow for the water storage is calculated from the solar thermal energy supply, heat consumption, and the surplus electrical power in the power grid. A broad numerical simulation study reveals the time course of the pistons position and the spatial temperature distribution in the storage and surrounding soil. Varied parameters include the number of consumers supplied, storage geometry and power and heat production capacities. Adjusting the storage geometry allows further system optimizations to specific regional supply conditions. Results indicate that the TPPS can efficiently be a hybrid energy storage. Notably, the efficiency of thermal storage increases with the system size and from a TPPS size exceeding a 100 MWhpot storage capacity enables a reliable supply of solely renewable energy for both power and heat demand.},
  langid = {english},
  file = {C:\Users\st184489\OneDrive\Dokumente\Studium_Stuttgart\25_26_WS\BA_bigData\literature\2024_Haeuslein-et-a l_Dynamic_modeling_thermal_pumped_piston_storage.pdf}
}

@article{schaeferDevelopmentZeroenergysaunaSimulation2022,
  title = {Development of a Zero-Energy-Sauna: {{Simulation}} Study of Thermal Energy Storage},
  shorttitle = {Development of a Zero-Energy-Sauna},
  author = {Schaefer, M. and Raab, A. and Gerle, M. and Pfeiler, D. and Vogel, J. and Thess, André},
  date = {2022-02},
  journaltitle = {Energy and Buildings},
  shortjournal = {Energy and Buildings},
  volume = {256},
  pages = {111659},
  issn = {03787788},
  doi = {10.1016/j.enbuild.2021.111659},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S0378778821009439},
  urldate = {2025-11-21},
  abstract = {As a practical contribution to the energy transition from fossil to renewable energy, this paper addresses a wellness product with high energy demand: the sauna. The overall goal of the presented research project is to develop and demonstrate a so-called Zero-Energy-Sauna. In this paper, the development by means of numerical simulations is discussed. In a preliminary study, multiple concepts have been systematically derived and assessed. One innovative concept has been patented and an extended version of this concept is being implemented in this research project. The implemented concept utilizes solar energy and applies two types of thermal energy storage: a pressurized, stratified hot water storage and a closed low-pressure adsorption storage. The main purpose of the hot water storage is the heat supply, while the purpose of the adsorption storage is to provide steam. We formulate and investigate two numerical models for these thermal energy storages. For the hot water storage, an one-dimensional model is applied which considers the effect of natural convection. With this model, different charging and discharging scenarios are examined, proving the applicability of this type of hot water storage for a Zero-Energy-Sauna. For the adsorption storage, a previously developed and published model is adopted and extended by a metal plate for manual steam generation. Based on this model, various configurations of the adsorption storage are studied, revealing an optimum design for maximum steam generation. The storage designs derived by numerical simulations serve as blueprints for the two thermal energy storages. Both storages are currently being implemented and experimentally investigated in the Zero-Energy-Sauna of the ongoing research project. Ó 2021 Elsevier B.V. All rights reserved.},
  langid = {english},
  file = {C:\Users\st184489\OneDrive\Dokumente\Studium_Stuttgart\25_26_WS\BA_bigData\literature\2021_Schaefer-et-al_Development_Zero-Energy-Sauna.pdf}
}

